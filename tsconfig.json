{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],

    // Node 22 chay truc tiep file .ts bang cach xoa phan type,
    // nen import ghi la './util.ts' va project khong can build.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // Chi cho phep cu phap xoa duoc (khong enum, khong parameter property),
    // dam bao Node luon chay duoc.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
